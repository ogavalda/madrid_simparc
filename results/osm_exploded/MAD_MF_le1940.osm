OS:EnergyManagementSystem:Program,
  {95b013c2-5219-461e-8276-8a2d595eda66}, !- Handle
  other_multifamily_buffer_space_Temperature_Program, !- Name
  Set other_multifamily_buffer_space_temp_sch = 0.0, !- Program Line 1
  Set other_multifamily_buffer_space_temp_sch = other_multifamily_buffer_space_temp_sch + (cond_zone_temp * 0.5), !- Program Line 2
  Set other_multifamily_buffer_space_temp_sch = other_multifamily_buffer_space_temp_sch + (oa_temp * 0.5), !- Program Line 3
  If other_multifamily_buffer_space_temp_sch < 10.0, !- Program Line 4
  Set other_multifamily_buffer_space_temp_sch = 10.0, !- Program Line 5
  EndIf;                                  !- Program Line 6


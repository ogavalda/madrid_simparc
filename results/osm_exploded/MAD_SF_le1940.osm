OS:EnergyManagementSystem:Program,
  {a0bae261-b741-41a5-beff-0a01da694db0}, !- Handle
  water_heater_EC_adj,                    !- Name
  If WarmupFlag == 0,                     !- Program Line 1
  Set dhw_e_cons = water_heater_energy + water_heater_on_cycle_parasitic + water_heater_off_cycle_parasitic, !- Program Line 2
  Set water_heater_ec_adj_act = 0.0 * dhw_e_cons / 1, !- Program Line 3
  EndIf;                                  !- Program Line 4

